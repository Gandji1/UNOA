{
  "name": "unoa",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @unoa/web dev",
    "build": "turbo run build",
    "test": "node --test packages/config/test/*.test.mjs packages/domain/test/*.test.mjs",
    "trace": "python3 automation/verifier_tracabilite.py",
    "db:migrate": "pnpm --filter @unoa/db migrate",
    "test:integration": "pnpm --filter @unoa/db test",
    "test:http": "pnpm --filter @unoa/web test:http",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "db:bootstrap": "pnpm --filter @unoa/db bootstrap",
    "worker": "pnpm --filter @unoa/worker start"
  },
  "devDependencies": {
    "turbo": "2.5.8"
  }
}
