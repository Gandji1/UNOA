\set ON_ERROR_STOP on
SELECT current_database() AS base,
       current_setting('server_version') AS postgres,
       (SELECT count(*) FROM unoa_meta.migration) AS migrations,
       has_schema_privilege(:'web_role', 'unoa', 'USAGE') AS app_schema,
       NOT has_schema_privilege(:'web_role', 'unoa', 'CREATE') AS app_cannot_create,
       NOT has_schema_privilege(:'web_role', 'unoa_meta', 'USAGE') AS migrations_private,
       has_function_privilege(:'web_role', 'unoa.has_scope_permission(uuid,text,uuid)', 'EXECUTE') AS scope_check,
       has_column_privilege(:'web_role', 'unoa.login_session', 'token_hash', 'INSERT') AS session_insert,
       has_column_privilege(:'web_role', 'unoa.audit_event', 'outcome', 'INSERT') AS audit_append,
       NOT has_any_column_privilege(:'web_role', 'unoa.audit_event', 'SELECT, UPDATE') AS audit_private,
       NOT has_table_privilege(:'web_role', 'unoa.audit_event', 'DELETE, TRUNCATE') AS audit_protected,
       NOT has_any_column_privilege(:'web_role', 'unoa.role_grant', 'INSERT, UPDATE') AS grants_protected,
       NOT has_table_privilege(:'web_role', 'unoa.role_grant', 'DELETE, TRUNCATE') AS grants_preserved,
       has_column_privilege(:'web_role', 'unoa.scope', 'time_zone', 'UPDATE') AS territory_edit,
       has_table_privilege(:'web_role', 'unoa.scope_attachment', 'INSERT') AS territory_attach,
       NOT has_table_privilege(:'web_role', 'unoa.scope_attachment', 'DELETE, TRUNCATE') AS attachments_preserved,
       has_function_privilege(:'web_role', 'unoa.public_programs(uuid)', 'EXECUTE') AS public_catalogue,
       has_function_privilege(:'web_role', 'unoa.public_site(text,text)', 'EXECUTE') AS public_site,
       NOT has_table_privilege(:'web_role', 'unoa.site_text', 'DELETE, TRUNCATE') AS site_texts_preserved,
       NOT has_column_privilege(:'web_role', 'unoa.site_text', 'name', 'UPDATE') AS site_texts_versioned,
       has_table_privilege(:'web_role', 'unoa.teaching_unit', 'INSERT') AS curriculum_edit,
       NOT has_table_privilege(:'web_role', 'unoa.program_version', 'DELETE, TRUNCATE') AS versions_preserved,
       NOT has_table_privilege(:'web_role', 'unoa.program_authorization', 'DELETE, TRUNCATE') AS authorizations_preserved,
       NOT has_table_privilege(:'web_role', 'unoa.org_unit', 'DELETE, TRUNCATE') AS units_preserved,
       NOT has_column_privilege(:'web_role', 'unoa.org_unit', 'code', 'UPDATE') AS unit_code_frozen,
       NOT has_table_privilege(:'web_role', 'unoa.live_session', 'DELETE, TRUNCATE') AS sessions_preserved,
       NOT has_table_privilege(:'web_role', 'unoa.forum_post', 'DELETE, TRUNCATE') AS posts_preserved,
       NOT has_column_privilege(:'web_role', 'unoa.forum_post', 'body', 'UPDATE') AS posts_unaltered,
       NOT has_table_privilege(:'web_role', 'unoa.application_document', 'DELETE, TRUNCATE') AS documents_preserved,
       NOT has_table_privilege(:'web_role', 'unoa.application_decision', 'UPDATE, DELETE') AS decisions_append_only,
       NOT has_function_privilege(:'web_role', 'unoa.bootstrap_platform(text,text,text,text,text,text)', 'EXECUTE') AS bootstrap_private,
       NOT has_column_privilege(:'web_role', 'unoa.invitation', 'token_hash', 'SELECT') AS invitation_tokens_private,
       NOT has_any_column_privilege(:'web_role', 'unoa.access_role', 'INSERT, UPDATE') AS roles_through_functions,
       NOT has_table_privilege(:'web_role', 'unoa.role_permission', 'INSERT, DELETE') AS role_permissions_protected,
       has_function_privilege(:'web_role', 'unoa.grant_role(uuid,uuid,text,uuid,boolean,timestamptz,text,uuid)', 'EXECUTE') AS checked_grants,
       NOT has_table_privilege(:'web_role', 'unoa.delivery_attempt', 'UPDATE, DELETE, TRUNCATE') AS deliveries_append_only,
       NOT has_table_privilege(:'web_role', 'unoa.contact_consent', 'UPDATE, DELETE, TRUNCATE') AS consents_append_only,
       NOT has_column_privilege(:'web_role', 'unoa.notification_template', 'body', 'UPDATE') AS templates_versioned,
       NOT has_column_privilege(:'web_role', 'unoa.job', 'payload', 'UPDATE') AS job_payload_frozen,
       NOT has_table_privilege(:'web_role', 'unoa.local_credential', 'INSERT, DELETE, TRUNCATE') AS credentials_through_functions,
       NOT has_column_privilege(:'web_role', 'unoa.local_credential', 'login', 'UPDATE') AS credential_login_frozen,
       NOT has_table_privilege(:'web_role', 'unoa.student_event', 'UPDATE, DELETE, TRUNCATE') AS student_history_kept,
       NOT has_column_privilege(:'web_role', 'unoa.student', 'matricule', 'UPDATE') AS matricule_frozen,
       NOT has_table_privilege(:'web_role', 'unoa.council_vote', 'UPDATE, DELETE, TRUNCATE') AS votes_append_only,
       NOT has_column_privilege(:'web_role', 'unoa.council_decision', 'outcome', 'UPDATE') AS decisions_frozen,
       (SELECT NOT (rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls)
          FROM pg_roles WHERE rolname = :'web_role') AS app_role_restricted;
