\set ON_ERROR_STOP on
BEGIN;
GRANT USAGE ON SCHEMA unoa TO :"web_role";
GRANT SELECT (id, disabled_at, session_epoch) ON unoa.account TO :"web_role";
GRANT SELECT (issuer, subject, account_id) ON unoa.login_identity TO :"web_role";
GRANT SELECT (token_hash, account_id, account_epoch, expires_at, revoked_at),
      INSERT (token_hash, account_id, account_epoch, expires_at),
      UPDATE (revoked_at) ON unoa.login_session TO :"web_role";
GRANT EXECUTE ON FUNCTION unoa.has_scope_permission(uuid, text, uuid) TO :"web_role";
GRANT INSERT (actor_id, scope_id, action, correlation_id, resource_id, outcome)
ON unoa.audit_event TO :"web_role";
GRANT SELECT ON unoa.scope, unoa.scope_type TO :"web_role";
GRANT SELECT, INSERT ON unoa.config_definition TO :"web_role";
GRANT SELECT ON unoa.config_value TO :"web_role";
GRANT INSERT (request_id, definition_key, scope_id, value, reason, effective_from, author_id),
      UPDATE (state, approved_by, reviewed_against, published_by, published_at)
ON unoa.config_value TO :"web_role";
GRANT INSERT (version_id, scope_id, actor_id, correlation_id)
ON unoa.config_publication_event TO :"web_role";
GRANT INSERT (id, type_code, parent_id, label, time_zone, currency, locale,
              legal_name, contact, present_from, present_until),
      UPDATE (label, time_zone, currency, locale, legal_name, contact, present_until)
ON unoa.scope TO :"web_role";
GRANT INSERT (code, label, nature) ON unoa.scope_type TO :"web_role";
GRANT SELECT, INSERT ON unoa.scope_type_parent TO :"web_role";
GRANT SELECT, INSERT ON unoa.scope_label TO :"web_role";
GRANT UPDATE (label, updated_at) ON unoa.scope_label TO :"web_role";
GRANT SELECT, INSERT ON unoa.scope_attachment TO :"web_role";
GRANT UPDATE (effective_until) ON unoa.scope_attachment TO :"web_role";
GRANT EXECUTE ON FUNCTION unoa.nearest_institution(uuid), unoa.academic_owner(uuid),
      unoa.program_regulatory_status(uuid), unoa.program_admission_allowed(uuid) TO :"web_role";
GRANT SELECT ON unoa.org_unit, unoa.org_position, unoa.org_appointment, unoa.org_capacity,
      unoa.org_change, unoa.org_succession TO :"web_role";
GRANT INSERT (scope_id, code, mission, public, proposed_by, status, decided_by, decided_at),
      UPDATE (status, public, mission, decided_by, decided_at, closed_at) ON unoa.org_unit TO :"web_role";
GRANT INSERT (unit_id, title, is_head, seats, public, created_by) ON unoa.org_position TO :"web_role";
GRANT INSERT (position_id, account_id, capacity, public_name, reason, effective_from, effective_until, appointed_by),
      UPDATE (effective_until) ON unoa.org_appointment TO :"web_role";
GRANT INSERT (unit_id, resource, quantity, measure, reason, effective_from, recorded_by) ON unoa.org_capacity TO :"web_role";
GRANT INSERT (unit_id, kind, target_id, reason, effective_at, requested_by),
      UPDATE (state, decided_by, decided_at, decision_note, successor_id) ON unoa.org_change TO :"web_role";
GRANT INSERT ON unoa.org_succession TO :"web_role";
GRANT SELECT ON unoa.field_type, unoa.field_type_parent, unoa.academic_field, unoa.program_kind,
      unoa.program, unoa.program_label, unoa.program_version, unoa.program_authorization,
      unoa.program_period, unoa.option_group, unoa.teaching_unit, unoa.unit_volume, unoa.course,
      unoa.unit_course, unoa.unit_prerequisite, unoa.competency, unoa.version_competency,
      unoa.unit_competency, unoa.version_requirement, unoa.version_territory, unoa.unit_equivalence TO :"web_role";
GRANT INSERT (code, label, root_allowed) ON unoa.field_type TO :"web_role";
GRANT INSERT ON unoa.field_type_parent TO :"web_role";
GRANT INSERT (owner_scope_id, type_code, parent_id, code, label, description, created_by),
      UPDATE (label, description, status) ON unoa.academic_field TO :"web_role";
GRANT INSERT (code, label, degree_awarding, description) ON unoa.program_kind TO :"web_role";
GRANT INSERT (owner_scope_id, field_id, kind_code, code, title, created_by), UPDATE (title) ON unoa.program TO :"web_role";
GRANT INSERT, UPDATE (title, summary, updated_at) ON unoa.program_label TO :"web_role";
GRANT INSERT (program_id, number, based_on, title, organisation, duration, delivery_mode, credit_unit,
              expected_credits, languages, capacity, objectives, admission, author_id),
      UPDATE (state, title, organisation, duration, delivery_mode, credit_unit, expected_credits, languages,
              capacity, objectives, admission, submitted_at, reviewer_id, reviewed_at, review_note,
              publisher_id, published_at, admission_open, admission_changed_by, admission_changed_at)
ON unoa.program_version TO :"web_role";
GRANT INSERT (program_id, territory_id, status, authority, evidence, valid_from, valid_until, recorded_by),
      UPDATE (verified_by, verified_at) ON unoa.program_authorization TO :"web_role";
GRANT INSERT (owner_scope_id, code, title, description, created_by), UPDATE (title, description) ON unoa.course TO :"web_role";
GRANT INSERT (owner_scope_id, code, label, description, created_by) ON unoa.competency TO :"web_role";
-- Draft curriculum content is edited, deleted and copied; triggers refuse any
-- change once the version leaves the draft state.
GRANT INSERT, UPDATE, DELETE ON unoa.program_period, unoa.option_group, unoa.teaching_unit, unoa.unit_volume,
      unoa.unit_course, unoa.unit_prerequisite, unoa.version_competency, unoa.unit_competency,
      unoa.version_requirement, unoa.version_territory, unoa.unit_equivalence TO :"web_role";
GRANT EXECUTE ON FUNCTION unoa.offering_role(uuid, uuid) TO :"web_role";
GRANT SELECT ON unoa.course_version, unoa.course_module, unoa.lesson, unoa.course_offering, unoa.offering_member,
      unoa.lesson_due, unoa.lesson_progress, unoa.learner_note, unoa.forum_thread, unoa.forum_post,
      unoa.live_session, unoa.live_event, unoa.live_attendance, unoa.live_consent, unoa.live_resource,
      unoa.notification TO :"web_role";
GRANT INSERT (course_id, number, language, variant_of, variant_note, title, objectives, prerequisites, methods,
              bibliography, expected_hours, author_id),
      UPDATE (state, title, objectives, prerequisites, methods, bibliography, expected_hours, variant_note,
              submitted_at, reviewer_id, discipline_checked, pedagogy_checked, rights_checked, review_note, published_at)
ON unoa.course_version TO :"web_role";
GRANT INSERT, UPDATE, DELETE ON unoa.course_module, unoa.lesson TO :"web_role";
GRANT INSERT (course_version_id, owner_scope_id, label, time_zone, starts_on, ends_on, created_by),
      UPDATE (state, label, ends_on) ON unoa.course_offering TO :"web_role";
GRANT INSERT (offering_id, account_id, role, display_name, added_by), UPDATE (removed_at, removed_by)
ON unoa.offering_member TO :"web_role";
GRANT INSERT, UPDATE (due_at, set_by) ON unoa.lesson_due TO :"web_role";
GRANT INSERT (offering_id, lesson_id, account_id) ON unoa.lesson_progress TO :"web_role";
GRANT INSERT, UPDATE (body, bookmarked, updated_at) ON unoa.learner_note TO :"web_role";
GRANT INSERT (offering_id, title, created_by), UPDATE (locked_at) ON unoa.forum_thread TO :"web_role";
GRANT INSERT (thread_id, author_id, body), UPDATE (hidden_at, hidden_by, hidden_reason) ON unoa.forum_post TO :"web_role";
GRANT INSERT (offering_id, title, agenda, starts_at, ends_at, room, recording_planned, created_by),
      UPDATE (title, agenda, starts_at, ends_at, state, cancel_reason, recording_planned, replay_url, replay_published_at)
ON unoa.live_session TO :"web_role";
GRANT INSERT (session_id, kind, actor_id, starts_at, ends_at, detail) ON unoa.live_event TO :"web_role";
GRANT INSERT, UPDATE (first_joined_at, joins, status, marked_by, marked_at) ON unoa.live_attendance TO :"web_role";
GRANT INSERT, UPDATE (decision, decided_at) ON unoa.live_consent TO :"web_role";
GRANT INSERT (session_id, title, url, shared_by) ON unoa.live_resource TO :"web_role";
GRANT INSERT (account_id, kind, title, body, link), UPDATE (read_at) ON unoa.notification TO :"web_role";
GRANT EXECUTE ON FUNCTION unoa.scope_within(uuid, uuid), unoa.site_scope(uuid), unoa.public_site(text, text),
      unoa.public_programs(uuid), unoa.public_program_sheet(uuid, uuid), unoa.public_org_units(uuid),
      unoa.public_org_positions(uuid), unoa.account_permissions(uuid) TO :"web_role";
GRANT SELECT ON unoa.site, unoa.site_host, unoa.site_text TO :"web_role";
GRANT INSERT (scope_id, default_language, created_by), UPDATE (default_language, online, changed_by, changed_at)
ON unoa.site TO :"web_role";
GRANT INSERT (host, site_id, created_by), DELETE ON unoa.site_host TO :"web_role";
GRANT INSERT (site_id, language, name, short_name, tagline, hero_title, hero_text, hero_image_url, about, contact,
              legal_notice, privacy_notice, footer, author_id),
      UPDATE (state, published_by, published_at) ON unoa.site_text TO :"web_role";
GRANT EXECUTE ON FUNCTION unoa.public_rounds(uuid, uuid) TO :"web_role";
GRANT SELECT ON unoa.admission_round, unoa.application, unoa.application_revision, unoa.application_document,
      unoa.application_request, unoa.application_review, unoa.application_interview, unoa.application_decision,
      unoa.application_appeal TO :"web_role";
GRANT INSERT (version_id, label, opens_at, closes_at, form, documents, criteria, instructions, created_by),
      UPDATE (label, opens_at, closes_at, form, documents, criteria, instructions, state, opened_by) ON unoa.admission_round TO :"web_role";
GRANT INSERT (round_id, applicant_id), UPDATE (state, answers, receipt, submitted_at, revision, decision) ON unoa.application TO :"web_role";
GRANT INSERT ON unoa.application_revision TO :"web_role";
GRANT INSERT (application_id, document_key, filename, format, size_bytes, sha256, content), UPDATE (state, note, checked_by)
ON unoa.application_document TO :"web_role";
GRANT INSERT (application_id, message, requested_by), UPDATE (answered_at) ON unoa.application_request TO :"web_role";
GRANT INSERT (application_id, kind, reviewer_id, scores, score, recommendation, note) ON unoa.application_review TO :"web_role";
GRANT INSERT (application_id, kind, scheduled_at, place, outcome, scheduled_by), UPDATE (outcome) ON unoa.application_interview TO :"web_role";
GRANT INSERT (application_id, decision, reason, conditions, decided_by, supersedes) ON unoa.application_decision TO :"web_role";
GRANT INSERT (application_id, decision_id, reason), UPDATE (state, ruled_by, ruled_at, ruling) ON unoa.application_appeal TO :"web_role";
-- 0011: administration of access through checked functions only.
GRANT SELECT (display_name, email, origin, created_at, disabled_reason), UPDATE (display_name, email) ON unoa.account TO :"web_role";
GRANT SELECT ON unoa.permission, unoa.access_role, unoa.role_permission TO :"web_role";
GRANT SELECT (id, display_name, email, role_code, scope_id, include_descendants, grant_until, reason, invited_by,
      created_at, expires_at, accepted_at, accepted_account, revoked_at) ON unoa.invitation TO :"web_role";
GRANT UPDATE (open_registration) ON unoa.site TO :"web_role";
GRANT EXECUTE ON FUNCTION unoa.can_grant(uuid, text, uuid, text), unoa.covers_account(uuid, text, uuid),
      unoa.accept_invitation(bytea, text, text), unoa.register_account(uuid, text, text),
      unoa.compose_role(uuid, text, text, text, text[], uuid), unoa.archive_role(uuid, text, uuid),
      unoa.grant_role(uuid, uuid, text, uuid, boolean, timestamptz, text, uuid), unoa.revoke_grant(uuid, uuid, text, uuid),
      unoa.delegate_grant(uuid, uuid, uuid, timestamptz, text, uuid),
      unoa.invite_account(uuid, bytea, text, text, text, uuid, boolean, timestamptz, text, integer, uuid),
      unoa.revoke_invitation(uuid, uuid, uuid), unoa.set_account_state(uuid, uuid, boolean, text, uuid),
      unoa.revoke_account_sessions(uuid, uuid, uuid), unoa.iam_accounts(uuid, uuid, text), unoa.iam_account(uuid, uuid),
      unoa.iam_sessions(uuid, uuid), unoa.audit_trail(uuid, uuid, text, timestamptz), unoa.invitation_preview(bytea) TO :"web_role";
-- 0012: notifications, consents, durable queue and delivery proof.
GRANT SELECT ON unoa.notification_event, unoa.notification_template, unoa.contact_consent, unoa.notification_preference,
      unoa.job, unoa.delivery_attempt, unoa.sandbox_message TO :"web_role";
GRANT INSERT (scope_id, event_code, channel, language, subject, body, author_id), UPDATE (state, published_by, published_at)
      ON unoa.notification_template TO :"web_role";
GRANT SELECT (language, phone), UPDATE (language, phone) ON unoa.account TO :"web_role";
GRANT INSERT (account_id, channel, granted, source) ON unoa.contact_consent TO :"web_role";
GRANT INSERT (account_id, event_code, channel, enabled), UPDATE (enabled, updated_at) ON unoa.notification_preference TO :"web_role";
GRANT INSERT (scope_id, template_id, language) ON unoa.notification TO :"web_role";
GRANT INSERT (kind, payload, scope_id, idempotency_key, correlation_id),
      UPDATE (state, attempts, run_after, locked_until, last_error, finished_at, replayed_by, replayed_at) ON unoa.job TO :"web_role";
GRANT INSERT (job_id, notification_id, channel, adapter, recipient_masked, status, provider_ref, error) ON unoa.delivery_attempt TO :"web_role";
GRANT INSERT (job_id, channel, recipient, subject, body) ON unoa.sandbox_message TO :"web_role";
-- 0013: local sign-in and one-time installation.
GRANT SELECT ON unoa.local_credential, unoa.installation TO :"web_role";
GRANT UPDATE (password_hash, totp_secret, failed_attempts, locked_until, must_change, changed_at) ON unoa.local_credential TO :"web_role";
GRANT EXECUTE ON FUNCTION unoa.install_platform(text, text, text, text, text, text) TO :"web_role";
-- 0014: student records.
GRANT SELECT ON unoa.matricule_rule, unoa.cohort, unoa.cohort_group, unoa.student, unoa.registration,
      unoa.course_registration, unoa.student_event TO :"web_role";
GRANT INSERT (institution_id, pattern, changed_by), UPDATE (pattern, changed_by, changed_at) ON unoa.matricule_rule TO :"web_role";
GRANT INSERT (version_id, institution_id, owner_scope_id, code, label, academic_year, starts_on, ends_on, capacity, created_by),
      UPDATE (state, capacity) ON unoa.cohort TO :"web_role";
GRANT INSERT (cohort_id, label) ON unoa.cohort_group TO :"web_role";
GRANT INSERT (account_id, institution_id, matricule, application_id, created_by), UPDATE (status) ON unoa.student TO :"web_role";
GRANT INSERT (student_id, cohort_id, group_id, academic_year, kind, conditions, created_by),
      UPDATE (state, group_id, conditions, decided_by, decided_at) ON unoa.registration TO :"web_role";
GRANT INSERT (registration_id, unit_id, state), UPDATE (state, changed_at) ON unoa.course_registration TO :"web_role";
GRANT INSERT (student_id, kind, detail, actor_id) ON unoa.student_event TO :"web_role";
GRANT EXECUTE ON FUNCTION unoa.next_matricule(uuid) TO :"web_role";
-- 0015: invitation accepted with a local identifier.
GRANT EXECUTE ON FUNCTION unoa.accept_invitation_local(bytea, text, text) TO :"web_role";
-- 0016: role levels.
GRANT EXECUTE ON FUNCTION unoa.set_role_level(uuid, text, text, uuid) TO :"web_role";
-- 0017: local self-registration.
GRANT EXECUTE ON FUNCTION unoa.register_local_account(uuid, text, text, text, text) TO :"web_role";
-- 0018: development mode and password reset.
GRANT EXECUTE ON FUNCTION unoa.set_development_mode(uuid, boolean, uuid), unoa.reset_local_password(uuid, uuid, text, boolean, uuid) TO :"web_role";
-- 0019: governance.
GRANT SELECT ON unoa.council, unoa.council_member, unoa.meeting, unoa.agenda_item, unoa.meeting_attendance, unoa.conflict_declaration,
      unoa.council_vote, unoa.council_decision, unoa.meeting_minutes, unoa.signature_delegation, unoa.meeting_document, unoa.decision_appeal TO :"web_role";
GRANT INSERT (scope_id, name, kind, quorum_percent, majority, created_by), UPDATE (name, quorum_percent, majority, archived_at) ON unoa.council TO :"web_role";
GRANT INSERT (council_id, account_id, office, voting, starts_on, ends_on, appointed_by), UPDATE (ends_on) ON unoa.council_member TO :"web_role";
GRANT INSERT (council_id, title, scheduled_at, place, created_by), UPDATE (state, agenda_version, scheduled_at, place, convened_at, opened_at, closed_at) ON unoa.meeting TO :"web_role";
GRANT INSERT (meeting_id, ordinal, title, description, kind, added_in_version), UPDATE (withdrawn_in_version, vote_state) ON unoa.agenda_item TO :"web_role";
GRANT INSERT, UPDATE (present, recorded_by, recorded_at) ON unoa.meeting_attendance TO :"web_role";
GRANT INSERT ON unoa.conflict_declaration, unoa.council_vote TO :"web_role";
GRANT INSERT (item_id, outcome, votes_for, votes_against, votes_abstain, present, text, effective_on, recorded_by),
      UPDATE (public_summary, published_by, published_at) ON unoa.council_decision TO :"web_role";
GRANT INSERT (meeting_id, body, drafted_by), UPDATE (body, drafted_by, drafted_at, signed_by, signed_at, sha256) ON unoa.meeting_minutes TO :"web_role";
GRANT INSERT (council_id, delegate_member, starts_on, ends_on, reason, granted_by) ON unoa.signature_delegation TO :"web_role";
GRANT INSERT (meeting_id, title, url, added_by) ON unoa.meeting_document TO :"web_role";
GRANT INSERT (decision_id, filed_by, reason), UPDATE (state, ruled_by, ruled_at, ruling) ON unoa.decision_appeal TO :"web_role";
GRANT EXECUTE ON FUNCTION unoa.public_decisions(uuid) TO :"web_role";
-- 0020: teachers.
GRANT SELECT ON unoa.teacher_profile, unoa.job_opening, unoa.teacher_application, unoa.teacher_review, unoa.teacher_contract,
      unoa.teaching_assignment, unoa.teaching_obligation TO :"web_role";
GRANT SELECT (id, application_id, kind, filename, format, size_bytes, sha256, content, state, note, checked_by, uploaded_at) ON unoa.teacher_document TO :"web_role";
GRANT INSERT, UPDATE (title, discipline, biography, publications, availability, updated_at) ON unoa.teacher_profile TO :"web_role";
GRANT INSERT (scope_id, title, discipline, level, region, description, closes_at, created_by), UPDATE (state) ON unoa.job_opening TO :"web_role";
GRANT INSERT (opening_id, scope_id, applicant_id, course_title, syllabus, pedagogy),
      UPDATE (course_title, syllabus, pedagogy, state, decision, decision_reason, decided_by, submitted_at) ON unoa.teacher_application TO :"web_role";
GRANT INSERT (application_id, kind, filename, format, size_bytes, sha256, content), UPDATE (state, note, checked_by) ON unoa.teacher_document TO :"web_role";
GRANT INSERT (application_id, kind, reviewer_id, recommendation, note, scheduled_at) ON unoa.teacher_review TO :"web_role";
GRANT INSERT (account_id, scope_id, application_id, function, starts_on, ends_on, hours, hourly_rate, currency, terms, renewed_from, created_by),
      UPDATE (state, teacher_signed_at, institution_signed_by, institution_signed_at, ended_at, end_reason) ON unoa.teacher_contract TO :"web_role";
GRANT INSERT (contract_id, offering_id, function, hours, grading_days, created_by), UPDATE (state, ended_at) ON unoa.teaching_assignment TO :"web_role";
GRANT INSERT (assignment_id, label, due_on, created_by), UPDATE (done_at) ON unoa.teaching_obligation TO :"web_role";
GRANT EXECUTE ON FUNCTION unoa.expire_teacher_contracts() TO :"web_role";
-- 0021: assessments.
GRANT SELECT ON unoa.question_bank, unoa.question, unoa.assessment, unoa.assessment_question, unoa.accommodation, unoa.attempt,
      unoa.attempt_file, unoa.grading, unoa.integrity_case TO :"web_role";
GRANT INSERT (scope_id, title, created_by) ON unoa.question_bank TO :"web_role";
GRANT INSERT (bank_id, lineage, version, kind, prompt, choices, answer, points, tags, author_id), UPDATE (retired_at, tags) ON unoa.question TO :"web_role";
GRANT INSERT (offering_id, title, kind, team, instructions, opens_at, closes_at, duration_minutes, attempts_allowed, draw_count, rubric, double_grading, created_by),
      UPDATE (title, instructions, opens_at, closes_at, duration_minutes, attempts_allowed, draw_count, rubric, double_grading, state, published_at) ON unoa.assessment TO :"web_role";
GRANT INSERT, DELETE ON unoa.assessment_question TO :"web_role";
GRANT INSERT, UPDATE (extra_minutes, extra_days, reason, granted_by, granted_at) ON unoa.accommodation TO :"web_role";
GRANT INSERT (id, assessment_id, account_id, number, team_label, team_members, questions, deadline), UPDATE (team_members, answers, saved_at, state, submitted_at, receipt, auto_score) ON unoa.attempt TO :"web_role";
GRANT INSERT (attempt_id, question_id, filename, format, size_bytes, sha256, content) ON unoa.attempt_file TO :"web_role";
GRANT INSERT (attempt_id, round, grader_id, scores, total, feedback) ON unoa.grading TO :"web_role";
GRANT INSERT (attempt_id, reported_by, reason), UPDATE (state, learner_response, answered_at, decision, decided_by, decided_at) ON unoa.integrity_case TO :"web_role";
-- 0022: grades, credits and juries.
GRANT SELECT ON unoa.grading_policy, unoa.jury, unoa.jury_member, unoa.rectification, unoa.grade_entry, unoa.jury_decision, unoa.jury_signature,
      unoa.credit_award, unoa.grade_appeal, unoa.transcript TO :"web_role";
GRANT EXECUTE ON FUNCTION unoa.grading_policy_for(uuid, date) TO :"web_role";
GRANT INSERT (scope_id, program_version_id, label, scale_max, pass_mark, unit_pass_mark, rounding, decimals, compensation, compensation_floor, resit, resit_rule,
      jury_quorum, appeal_days, effective_from, author_id), UPDATE (state, publisher_id, published_at) ON unoa.grading_policy TO :"web_role";
GRANT INSERT (scope_id, cohort_id, period_id, session, label, policy_id, quorum, publish_at, created_by),
      UPDATE (state, minutes, minutes_sha256, deliberated_at, published_at, publish_at) ON unoa.jury TO :"web_role";
GRANT INSERT (jury_id, account_id, role, added_by), UPDATE (present, role), DELETE ON unoa.jury_member TO :"web_role";
GRANT INSERT (id, jury_id, registration_id, appeal_id, reason, decided_by, sha256) ON unoa.rectification TO :"web_role";
GRANT INSERT (registration_id, unit_id, session, mark, absence, state, reason, supersedes, rectification_id, author_id) ON unoa.grade_entry TO :"web_role";
GRANT INSERT (id, jury_id, registration_id, average, outcome, credits, units, policy_id, amends, rectification_id) ON unoa.jury_decision TO :"web_role";
GRANT INSERT (jury_id, account_id, sha256, rectification_id) ON unoa.jury_signature TO :"web_role";
GRANT INSERT (student_id, unit_id, credits, mode, decision_id), UPDATE (revoked_at, revoked_by) ON unoa.credit_award TO :"web_role";
GRANT INSERT (decision_id, appellant_id, reason), UPDATE (state, response, decided_by, decided_at) ON unoa.grade_appeal TO :"web_role";
GRANT INSERT (student_id, content, sha256, issued_by) ON unoa.transcript TO :"web_role";
-- 0023: external national examinations (documentary follow-up).
GRANT SELECT ON unoa.external_exam, unoa.external_participation, unoa.external_evidence, unoa.external_verification, unoa.external_event TO :"web_role";
GRANT INSERT (scope_id, title, authority, official_url, session_label, description, created_by),
      UPDATE (title, authority, official_url, session_label, description, state, published_at) ON unoa.external_exam TO :"web_role";
GRANT INSERT (exam_id, account_id, candidate_number, statement), UPDATE (candidate_number, statement, withdrawn_at) ON unoa.external_participation TO :"web_role";
GRANT INSERT (participation_id, kind, issuing_authority, document_reference, stated_outcome, filename, format, size_bytes, sha256, content, deposited_by),
      UPDATE (state) ON unoa.external_evidence TO :"web_role";
GRANT INSERT (evidence_id, step, method, note, verifier_id, proof_filename, proof_sha256, proof_content) ON unoa.external_verification TO :"web_role";
GRANT INSERT (participation_id, kind, detail, actor_id) ON unoa.external_event TO :"web_role";
COMMIT;
