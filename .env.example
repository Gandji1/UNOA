# Runtime web. Production requires HTTPS and PostgreSQL sslmode=verify-full.
UNOA_WEB_ORIGIN=
UNOA_OIDC_ISSUER=
UNOA_OIDC_CLIENT_ID=
UNOA_OIDC_CLIENT_SECRET=
UNOA_OIDC_MFA_ACR=
UNOA_OIDC_TRANSACTION_KEY=
UNOA_IAM_DATABASE_URL=

# Videoconference (Jitsi-compatible server with JWT authentication). Leave empty
# until a provider is contracted: sessions are planned, join links are refused.
UNOA_LIVE_JITSI_DOMAIN=
UNOA_LIVE_JITSI_APP_ID=
UNOA_LIVE_JITSI_SECRET=

# Migration and disposable integration test accounts.
UNOA_MIGRATION_DATABASE_URL=
UNOA_TEST_DATABASE_URL=

# Notifications (lot 012). Adapters: empty = channel disabled; "sandbox" keeps
# messages in the database (never in production); "http" posts JSON to a relay.
UNOA_ENVIRONMENT=
UNOA_EMAIL_ADAPTER=
UNOA_EMAIL_HTTP_URL=
UNOA_EMAIL_HTTP_TOKEN=
UNOA_EMAIL_HTTP_FROM=
UNOA_SMS_ADAPTER=
UNOA_SMS_HTTP_URL=
UNOA_SMS_HTTP_TOKEN=
UNOA_SMS_HTTP_FROM=
# Queue: token of /api/v1/jobs/run (Vercel cron uses CRON_SECRET), self-hosted worker URL (web role).
UNOA_JOBS_TOKEN=
CRON_SECRET=
UNOA_WORKER_DATABASE_URL=
